        "from PIL import Image\n",
        "\n",
        "def vit_classification_inference(roi_image: Image.Image, model, image_processor, device: torch.device):\n",
        "    \"\"\"\n",
        "    Performs classification inference on a cropped and resized ROI image using the trained ViT model.\n",
        "\n",
        "    Args:\n",
        "        roi_image (PIL.Image.Image): The preprocessed (cropped and resized) ROI image.\n",
        "        model: The trained ViT classification model.\n",
        "        image_processor: The ViT image processor.\n",
        "        device (torch.device): The device (CPU or CUDA) to run inference on.\n",
        "\n",
        "    Returns:\n",
        "        tuple: (predicted_class_name, confidence_score) or (None, None) if an error occurs.\n",
        "    \"\"\"\n",
        "    # 1. Prepare the roi_image for the ViT model\n",
        "    # The image_processor handles resizing and normalization based on model_checkpoint\n",
        "    inputs = image_processor(images=roi_image, return_tensors=\"pt\").to(device)\n",
        "\n",
        "    # 2. Set the model to evaluation mode\n",
        "    model.eval()\n",
        "\n",
        "    # 3. Perform a forward pass\n",
        "    with torch.no_grad():\n",
        "        outputs = model(**inputs)\n",
        "\n",
        "    # 4. Get logits and apply softmax to get probabilities\n",
        "    logits = outputs.logits\n",
        "    probabilities = torch.softmax(logits, dim=1)\n",
        "\n",
        "    # 5. Determine the predicted class ID and its confidence score\n",
        "    predicted_class_id = torch.argmax(probabilities, dim=1).item()\n",
        "    confidence_score = probabilities[0, predicted_class_id].item()\n",
        "\n",
        "    # 6. Convert the predicted class ID back to a human-readable fracture type\n",
        "    # id2label_vit is assumed to be available from previous steps\n",
        "    predicted_class_name = id2label_vit.get(predicted_class_id, \"Unknown\")\n",
        "\n",
        "    return predicted_class_name, confidence_score\n",
        "\n",
        "print(\"Function `vit_classification_inference` defined.\")"
