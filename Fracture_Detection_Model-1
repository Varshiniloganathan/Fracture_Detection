        "def get_attention_centroid_box(attention_map, image_size, box_scale=0.40):\n",
        "    \"\"\"\n",
        "    Generate a pseudo bounding box centered on ViT attention centroid.\n",
        "    \"\"\"\n",
        "    img_h, img_w = image_size\n",
        "\n",
        "    attn = attention_map.cpu().numpy()\n",
        "    attn = (attn - attn.min()) / (attn.max() - attn.min() + 1e-8)\n",
        "\n",
        "    # Compute weighted centroid\n",
        "    y_idx, x_idx = np.indices(attn.shape)\n",
        "    cx = (attn * x_idx).sum() / attn.sum()\n",
        "    cy = (attn * y_idx).sum() / attn.sum()\n",
        "\n",
        "    # Map centroid to image coordinates\n",
        "    cx_img = int(cx / attn.shape[1] * img_w)\n",
        "    cy_img = int(cy / attn.shape[0] * img_h)\n",
        "\n",
        "    # Box size (relative to image)\n",
        "    bw = int(img_w * box_scale)\n",
        "    bh = int(img_h * box_scale)\n",
        "\n",
        "    x1 = max(0, cx_img - bw // 2)\n",
        "    y1 = max(0, cy_img - bh // 2)\n",
        "    x2 = min(img_w, cx_img + bw // 2)\n",
        "    y2 = min(img_h, cy_img + bh // 2)\n",
        "\n",
        "    return [x1, y1, x2, y2]\n",
