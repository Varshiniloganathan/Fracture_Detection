        "def generate_attention_map(attention_weights, head_fusion_method='mean'):\n",
        "    attention_weights = attention_weights.squeeze(0)  # (num_heads, tokens, tokens)\n",
        "\n",
        "    cls_attention = attention_weights[:, 0, 1:]  # CLS → patches\n",
        "\n",
        "    if head_fusion_method == 'mean':\n",
        "        attention_map_flat = cls_attention.mean(dim=0)\n",
        "    elif head_fusion_method == 'max':\n",
        "        attention_map_flat = cls_attention.max(dim=0).values\n",
        "    else:\n",
        "        raise ValueError(\"head_fusion_method must be 'mean' or 'max'\")\n",
        "\n",
        "    num_patches_actual = attention_map_flat.shape[0]\n",
        "    h = w = int(np.sqrt(num_patches_actual))\n",
        "\n",
        "    attention_map = attention_map_flat.reshape(h, w)\n",
        "\n",
        "    # 🔥 normalize (recommended)\n",
        "    attention_map = (attention_map - attention_map.min()) / (\n",
        "        attention_map.max() - attention_map.min() + 1e-8\n",
        "    )\n",
        "\n",
        "    return attention_map\n",
