        "# Ensure the model is in evaluation mode\n",
        "model.eval()\n",
        "\n",
        "# Select 2 random images from the training dataset\n",
        "sample_indices = random.sample(range(len(det_train_dataset)), 2)\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(15, 8))\n",
        "axes = axes.flatten()\n",
        "\n",
        "print(\"Displaying sample images with predicted bounding boxes:\")\n",
        "\n",
        "for i, idx in enumerate(sample_indices):\n",
        "    # Get image\n",
        "    item = det_dataset_raw[idx]\n",
        "    image_path = item[\"image_path\"]\n",
        "    original_image = Image.open(image_path).convert(\"RGB\")\n",
        "\n",
        "    # Prepare input\n",
        "    inputs = feature_extractor(\n",
        "        images=original_image,\n",
        "        return_tensors=\"pt\"\n",
        "    ).to(device)\n",
        "\n",
        "    # Forward pass\n",
        "    with torch.no_grad():\n",
        "        outputs = model(**inputs)\n",
        "\n",
        "    # Debug: raw fracture scores\n",
        "    raw_logits = outputs.logits.softmax(-1)[0, :, 1]\n",
        "    topk = torch.topk(raw_logits, 5)\n",
        "    print(\"Top-5 raw fracture scores:\", topk.values)\n",
        "\n",
        "    # Post-process detections (NO threshold)\n",
        "    target_sizes = torch.tensor(\n",
        "        [original_image.size[::-1]]\n",
        "    ).to(device)\n",
        "\n",
        "    results = feature_extractor.post_process_object_detection(\n",
