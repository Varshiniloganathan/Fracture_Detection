        "from PIL import Image\n",
        "\n",
        "def crop_and_resize_roi(original_image: Image.Image, best_box: list, target_size: int = 224) -> Image.Image:\n",
        "    \"\"\"\n",
        "    Crops the region of interest (ROI) from an image using bounding box coordinates\n",
        "    and resizes it to a specified target size.\n",
        "\n",
        "    Args:\n",
        "        original_image (PIL.Image.Image): The original X-ray image.\n",
        "        best_box (list): Bounding box coordinates in [x_min, y_min, x_max, y_max] format.\n",
        "        target_size (int): The desired size (width and height) for the cropped and resized ROI.\n",
        "\n",
        "    Returns:\n",
        "        PIL.Image.Image: The cropped and resized ROI image.\n",
        "    \"\"\"\n",
        "    img_width, img_height = original_image.size\n",
        "\n",
        "    x_min, y_min, x_max, y_max = best_box\n",
        "\n",
        "    # Ensure coordinates are within image bounds\n",
        "    x_min = max(0, int(x_min))\n",
        "    y_min = max(0, int(y_min))\n",
        "    x_max = min(img_width, int(x_max))\n",
        "    y_max = min(img_height, int(y_max))\n",
        "\n",
        "    # Handle cases where the bounding box might be invalid or too small after clamping\n",
        "    if x_max <= x_min or y_max <= y_min:\n",
        "        # If the box is invalid, return a default resized image of the original\n",
        "        print(\"Warning: Invalid bounding box coordinates. Returning resized original image.\")\n",
        "        return original_image.resize((target_size, target_size))\n",
        "\n",
        "    # Crop the image\n",
        "    cropped_roi = original_image.crop((x_min, y_min, x_max, y_max))\n",
        "\n",
        "    # Resize the cropped ROI\n",
        "    resized_roi = cropped_roi.resize((target_size, target_size))\n",
        "\n",
        "    return resized_roi\n",
        "\n",
        "print(\"Function `crop_and_resize_roi` defined.\")"
