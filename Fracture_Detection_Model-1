        "from torch.utils.data import DataLoader\n",
        "import torch\n",
        "\n",
        "# 3. Create a custom collate_fn for the DataLoader\n",
        "def detr_collate_fn(batch):\n",
        "    pixel_values = [item[\"pixel_values\"] for item in batch]\n",
        "    labels = [item[\"labels\"] for item in batch]\n",
        "\n",
        "    # DETR feature extractor automatically pads images to the largest size in the batch\n",
        "    # if a list of images is passed directly to it. However, since we are processing\n",
        "    # images one by one in the Dataset's __getitem__ and manually squeezing the batch dim,\n",
        "    # we need to re-implement padding here or ensure the feature_extractor handles it.\n",
        "    # The feature_extractor's default behavior for `do_pad=True` is to pad to `max_size`,\n",
        "    # but when `annotations` are passed, it often processes images individually and\n",
        "    # then concatenates `pixel_values` in the `BatchFeature` output.\n",
        "    # For simplicity, we can let the feature extractor do the padding if we pass a list of images,\n",
        "    # or handle it manually if we are batching already processed tensors.\n",
        "    # In our case, `pixel_values` from `__getitem__` are already tensors with varying sizes\n",
        "    # due to the feature_extractor's internal resizing logic. Thus, manual padding is needed.\n",
        "\n",
        "    # Pad pixel_values to the largest image in the batch\n",
        "    # Get max height and width from the batch\n",
        "    max_h = max([img.shape[1] for img in pixel_values])\n",
        "    max_w = max([img.shape[2] for img in pixel_values])\n",
        "\n",
        "    padded_pixel_values = []\n",
        "    for img in pixel_values:\n",
        "        h, w = img.shape[1], img.shape[2]\n",
        "        pad_h = max_h - h\n",
        "        pad_w = max_w - w\n",
        "        # Pad with zeros (or mean pixel value if specified by feature_extractor)\n",
        "        # Using F.pad for consistency with what feature_extractor might do\n",
        "        padded_img = torch.nn.functional.pad(img, (0, pad_w, 0, pad_h))\n",
        "        padded_pixel_values.append(padded_img)\n",
        "\n",
        "    # Stack padded pixel values to create a batch tensor\n",
        "    pixel_values = torch.stack(padded_pixel_values)\n",
        "\n",
        "    return {\"pixel_values\": pixel_values, \"labels\": labels}\n",
        "\n",
        "print(\"Custom collate function `detr_collate_fn` defined.\")"
